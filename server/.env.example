# Database & server
DATABASE_URL=postgresql://gaia_user:gaia_password@postgres:5432/gaia_db
DB_SSL=false
PORT=3001
# AI Provider: 'openai' or 'gemini'
AI_PROVIDER=gemini
# OpenAI config (if using openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gemini / Google Generative AI config (if using gemini)
GEMINI_API_KEY=
GEMINI_API_URL=
GEMINI_MODEL=models/text-bison-001
# JWT secret
JWT_SECRET=change-me

# Google Ads (optional)
GOOGLE_ADS_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
