# Example .env for gaia (DO NOT COMMIT SECRETS TO VCS)
# Copy to .env and set secure values, then ensure file permissions are 600.

# Postgres
POSTGRES_USER=gaia_user
POSTGRES_PASSWORD=gaia_password
POSTGRES_DB=gaia_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=gaia_user
DB_PASSWORD=gaia_password
DB_NAME=gaia_db
DB_SSL=false

# Backend secrets
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET
AES_SECRET_KEY=REPLACE_WITH_STRONG_AES_KEY

# Other
NODE_ENV=production
PORT=3001
JWT_EXPIRATION=15m
